HOSTNAME_SERVIDOR=oportuniza-srv
DOMINIO_LOCAL=oportuniza.internal
DNS_PRIMARIOS="1.1.1.1 8.8.8.8"
DNS_FALLBACK="9.9.9.9 8.8.4.4"
FUSO_HORARIO=America/Sao_Paulo
SWAP_TAMANHO=2G

APP_PORTA=5080
APP_URL_SAUDE=http://127.0.0.1:5080/health
APP_URL_BASE=http://127.0.0.1:5080

APP_DIR=/opt/oportuniza/app
CONF_DIR=/etc/oportuniza
LOG_DIR=/var/log/oportuniza
BIN_DIR=/usr/local/bin

LIMITE_CPU=80
LIMITE_MEMORIA=80
LIMITE_DISCO=80
INTERVALO_MONITOR=15
FALHAS_ANTES_DE_RECUPERAR=2
